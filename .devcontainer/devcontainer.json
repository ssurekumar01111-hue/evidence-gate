{
  "name": "evidence-gate",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    }
  },

  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },

  "forwardPorts": [8000, 9002, 8080],
  "portsAttributes": {
    "8000": { "label": "Evidence Gate API (uvicorn)" },
    "9002": { "label": "DataHub UI" },
    "8080": { "label": "DataHub GMS (REST)" }
  },

  "postCreateCommand": "pip install --upgrade pip && pip install acryl-datahub",

  "remoteUser": "vscode"
}
