{
  "name": "evidence-gate",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",

  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    }
  },

  "forwardPorts": [8000, 9002, 8080],
  "portsAttributes": {
    "8000": { "label": "Evidence Gate API (uvicorn)" },
    "9002": { "label": "DataHub UI" },
    "8080": { "label": "DataHub GMS (REST)" }
  },

  "postCreateCommand": "pip install --upgrade pip && pip install acryl-datahub",

  "remoteUser": "vscode"
}